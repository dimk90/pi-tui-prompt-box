	"bugs": {
		"url": "https://github.com/dimk90/pi-tui-prompt-box/issues"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"coding-agent"
	],
	"engines": {
		"node": ">=22.19.0"
	},
